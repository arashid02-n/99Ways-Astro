---
import { getEmDashEntry, getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [settings, { entry: home }, { entries: posts }] = await Promise.all([
	getSiteSettings(),
	getEmDashEntry("pages", "home"),
	getEmDashCollection("posts", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: 20,
	}),
]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

/*
 * The homepage is composed from the "home" page entry in the CMS. Its
 * Portable Text blocks are mapped into a structured model here; the
 * academy post list is pinned to the three approved posts below.
 */
type ImageRef = { url: string; width?: number; height?: number; alt: string };
type Cta = { label: string; href: string };
type Founder = { image: ImageRef; name: string; role: string; bio: string };
type HomeModel = {
	hero: { title: string; subtitle: string; cta: Cta };
	system: { title: string };
	founders: { title: string; people: Founder[] };
	reviews: { title: string; images: ImageRef[] };
	academy: { title: string };
};

type Block = Record<string, any>;

function blockText(block: Block): string {
	return (block.children ?? [])
		.filter((c: Block) => c._type === "span" && typeof c.text === "string")
		.map((c: Block) => c.text)
		.join("");
}

function blockHref(block: Block): string | null {
	const link = (block.markDefs ?? []).find(
		(md: Block) => md._type === "link" && typeof md.href === "string",
	);
	return link ? link.href : null;
}

function parseHomePage(blocks: Block[]): HomeModel {
	const model: HomeModel = {
		hero: { title: "", subtitle: "", cta: { label: "Book Intro Call", href: "#" } },
		system: { title: "" },
		founders: { title: "", people: [] },
		reviews: { title: "", images: [] },
		academy: { title: "" },
	};

	let phase: "hero" | "system" | "founders" | "reviews" | "academy" | "tail" =
		"hero";
	let person: Founder | null = null;
	const paragraphs: string[] = [];

	const closePerson = () => {
		if (person) {
			model.founders.people.push(person);
			person = null;
		}
	};

	for (const b of blocks) {
		if (b._type === "image") {
			const img: ImageRef = {
				url: b.asset?.url ?? "",
				width: b.width,
				height: b.height,
				alt: b.alt ?? "",
			};
			if (phase === "founders") {
				closePerson();
				person = { image: img, name: "", role: "", bio: "" };
			} else if (phase === "reviews") model.reviews.images.push(img);
			continue;
		}
		if (b._type !== "block") continue;

		const style = b.style;
		const rawText = blockText(b).trim();
		const text = rawText.replace(/\s+/g, " ").trim();
		const href = blockHref(b);

		if (style === "h1") {
			model.hero.title = text;
			continue;
		}
		if (style === "h2") {
			if (phase === "hero" && !model.hero.subtitle) {
				model.hero.subtitle = text;
				continue;
			}
			closePerson();
			if (text === "The system behind predictable growth") {
				phase = "system";
				model.system.title = text;
			} else if (text.includes("Founder")) {
				phase = "founders";
				model.founders.title = text;
			} else if (text.includes("Review")) {
				phase = "reviews";
				model.reviews.title = text;
			} else if (text.includes("Latest from") || text.includes("Academy")) {
				phase = "academy";
				model.academy.title = text;
			} else {
				phase = "tail";
			}
			continue;
		}
		if (style === "normal" && phase === "hero" && href) {
			model.hero.cta = { label: text || model.hero.cta.label, href };
			continue;
		}
		if (phase === "founders" && person) {
			if (style === "h3") person.name = text;
			else if (style === "h6" && rawText) person.role = rawText;
			else if (style === "normal" && text) paragraphs.push(text);
			continue;
		}
	}
	closePerson();

	// Assign bio paragraphs to founders in document order.
	model.founders.people.forEach((p, i) => {
		p.bio = paragraphs[i] ?? "";
	});
	return model;
}

const homeModel = parseHomePage(home?.data?.content ?? []);

// "Book Intro Call" in the source content points at "#": wire it to the
// existing scheduling page so the primary CTA is not a dead link.
function resolveCta(cta: Cta | null): Cta {
	if (!cta) return { label: "Book Intro Call", href: "/pages/book-your-free-consultation" };
	const href = cta.href && cta.href !== "#" ? cta.href : "/pages/book-your-free-consultation";
	return { label: cta.label, href };
}

const heroCta = resolveCta(homeModel.hero.cta);
const founders = homeModel.founders;
const academy = homeModel.academy;

/*
 * Reviews are shown in the approved order (homepage-spec.md 5,
 * asset_manifest.md 2). The home entry stores the images in upload
 * order, so we reorder by the local media storage key of each file.
 */
const REVIEW_IDS = [
	"01M2JA5G00XR4280DXDXFFHEP4",
	"01M2JA5KWZYZQPTEM0BGRCZ5HW",
	"01M2JA5H3FKP4XZVCD3DD8P581",
	"01M2JA5GHP8FHE1DSXRV41BT42",
	"01M2JA5D7W9XHPM24VDGRV50TB",
	"01M2JA5KA2VVBGDYGT10NMPXX9",
	"01M2JA5JMS7A738T6BWAYAHQP7",
	"01M2JA5EAVA5VFBQTTE90H3CC6",
	"01M2JA5EXHEEMXZ7G6Z6W0GHMW",
];
function reviewStorageId(url: string): string {
	return (url.split("/").pop() ?? "").split(".")[0];
}
const reviews = [...homeModel.reviews.images].sort((a, b) => {
	const ia = REVIEW_IDS.indexOf(reviewStorageId(a.url));
	const ib = REVIEW_IDS.indexOf(reviewStorageId(b.url));
	return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
});

/*
 * Academy: pin the three approved posts in homepage-spec order.
 * Each entry id is the post slug (entry.id resolves to the slug).
 */
const ACADEMY_SLUGS = [
	"health-brand-case-study",
	"why-experimentation-is-important-for-business",
	"confidence-vs-posthog",
];
const academyPosts = ACADEMY_SLUGS.filter((slug) =>
	posts.some((p) => p.id === slug),
)
	.map((slug) => posts.find((p) => p.id === slug))
	.filter(Boolean) as typeof posts;
const viewAllHref = "/pages/academy";
---

<Base title={siteTitle} description={siteTagline}>
	<main class="home">
		<!-- Hero: centered typographic composition on the Hero background -->
		<header class="hero">
			<div class="hero-inner">
				<span class="hero-eyebrow">{siteTagline}</span>
				<h1 class="hero-title">
					Find and Pull Your Biggest Growth Levers with Experimentation
				</h1>
				<p class="hero-sub">
					We run your CRO operation, from research and prioritization to
					implementation and analysis.
				</p>
				<a class="btn btn--primary hero-cta" href={heroCta.href}>
					{heroCta.label}<span aria-hidden="true">→</span>
				</a>
			</div>
		</header>

		<!-- How I Find CRO Breakthroughs Again and Again (green family) -->
		<section class="section section--green system">
			<div class="section-head">
				<h2 class="section-title">How I Find CRO Breakthroughs Again and Again</h2>
			</div>
			<figure class="system-video">
				<iframe
					title="How I Find CRO Breakthroughs Again and Again"
					width="720"
					height="540"
					src="https://www.youtube.com/embed/STouQwJZ4bY?feature=oembed"
					loading="lazy"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</figure>
		</section>

		<!-- How Partners Review Us (blue family) -->
		{
			reviews.length > 0 && (
				<section class="section section--blue reviews">
					<div class="section-head reviews-head">
						<h2 class="section-title">How Partners Review Us</h2>
					</div>
					<div class="reviews-grid">
						{reviews.map((img) => (
							<figure
								class="review-fig"
								tabindex="0"
								role="button"
								aria-label="Enlarge review image"
							>
								<img
									src={img.url}
									width={img.width}
									height={img.height}
									alt={img.alt || "Client review"}
									loading="lazy"
									class="review-short"
								/>
							</figure>
						))}
					</div>
					<div class="review-lightbox" aria-hidden="true">
						<div class="review-lightbox-backdrop" data-close></div>
						<figure class="review-lightbox-fig">
							<img class="review-lightbox-img" alt="" />
							<button
								type="button"
								class="review-lightbox-close"
								aria-label="Close enlarged view"
							>
								×
							</button>
						</figure>
					</div>
				</section>
			)
		}

		<!-- About Us (green family) -->
		{
			founders.people.length > 0 && (
				<section class="section section--green founders">
					<div class="section-head">
						<h2 class="section-title">About Us</h2>
					</div>
					<div class="founders-grid">
						{founders.people.map((person, idx) => (
							<article
								class={idx === 1 ? "founder founder-mirror" : "founder"}
							>
								<div class="founder-side">
									{
										person.image.url && (
											<figure class="founder-figure">
												<img
													src={person.image.url}
													width={person.image.width}
													height={person.image.height}
													alt={person.name}
													loading="lazy"
													class="founder-portrait"
												/>
											</figure>
										)
									}
									<h3 class="founder-name">{person.name}</h3>
									<p class="founder-role">{person.role}</p>
								</div>
								<p class="founder-bio">{person.bio}</p>
							</article>
						))}
					</div>
				</section>
			)
		}

		<!-- Latest from 99Ways Academy (blue family) -->
		{
			academy.title && (
				<section class="section section--blue academy">
					<div class="section-head academy-head">
						<h2 class="section-title academy-title">{academy.title}</h2>
					</div>
					{
						academyPosts.length === 0 ? (
							<p class="home-empty">No posts have been published yet.</p>
						) : (
							<div class="academy-grid">
								{academyPosts.map((post) => {
									const category = post.data.terms?.category?.[0] ?? null;
									const featured = post.data.featured_image;
									const imageUrl =
										typeof featured === "string"
											? featured
											: featured?.meta?.storageKey
												? `/_emdash/api/media/file/${featured.meta.storageKey}`
												: null;
									const href = `/posts/${post.id}`;
									const published = post.data.publishedAt
										? new Date(post.data.publishedAt)
										: null;
									const dateLabel = published
										? published.toLocaleDateString("en-US", {
												year: "numeric",
												month: "short",
												day: "numeric",
											})
										: null;
									const minutes = getReadingTime(post.data.content);
									return (
										<article class="ac-card">
											{
												imageUrl && (
													<a
														href={href}
														class="ac-media"
														tabindex="-1"
														aria-hidden="true"
													>
														<img
															src={imageUrl}
															alt=""
															loading="lazy"
															class="ac-img"
														/>
													</a>
												)
											}
											<div class="ac-body">
												<p class="ac-meta">
													<a
														class="ac-cat"
														href={
															category
																? `/category/${category.slug}`
																: "#"
														}
													>
														{category?.label ?? "Uncategorized"}
													</a>
													<span class="ac-dot" aria-hidden="true" />
													{dateLabel && <span>{dateLabel}</span>}
													{minutes ? (
														<>
															<span class="ac-dot" aria-hidden="true" />
															<span>{minutes} min read</span>
														</>
													) : null}
												</p>
												<h3 class="ac-title">
													<a href={href} class="ac-title-link">
														{post.data.title ?? "Untitled"}
													</a>
												</h3>
												{post.data.excerpt && (
													<p class="ac-excerpt">{post.data.excerpt}</p>
												)}
												<span class="ac-cta">
													Read article
													<span class="ac-arrow" aria-hidden="true">→</span>
												</span>
											</div>
										</article>
									);
								})}
							</div>
						)
					}
					<div class="ac-more">
						<a class="btn btn--ghost ac-more-btn" href={viewAllHref}>
							View all posts
						</a>
					</div>
				</section>
			)
		}
	</main>
</Base>

<script>
	// Reviews lightbox: click (or Enter/Space) a review to enlarge it in a
	// modal overlay; close via the button, backdrop, or Escape.
	(function () {
		var section = document.querySelector(".reviews");
		if (!section) return;
		var overlay = section.querySelector(".review-lightbox");
		if (!overlay) return;
		var img = overlay.querySelector(".review-lightbox-img");
		var closeBtn = overlay.querySelector(".review-lightbox-close");
		var lastFocus = null;
		function open(src, alt) {
			lastFocus = document.activeElement;
			img.src = src;
			img.alt = alt || "Client review enlarged";
			overlay.classList.add("open");
			overlay.setAttribute("aria-hidden", "false");
			document.documentElement.style.overflow = "hidden";
			if (closeBtn) closeBtn.focus();
		}
		function close() {
			overlay.classList.remove("open");
			overlay.setAttribute("aria-hidden", "true");
			document.documentElement.style.overflow = "";
			if (lastFocus && lastFocus.focus) lastFocus.focus();
		}
		function openFromFigure(fig) {
			var source = fig.querySelector("img");
			if (!source) return;
			open(source.currentSrc || source.src, source.alt);
		}
		section.querySelectorAll(".review-fig").forEach(function (fig) {
			fig.addEventListener("click", function () {
				openFromFigure(fig);
			});
			fig.addEventListener("keydown", function (e) {
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					openFromFigure(fig);
				}
			});
		});
		overlay.addEventListener("click", function (e) {
			if (e.target.closest("[data-close]") || e.target.closest(".review-lightbox-close")) {
				close();
			}
		});
		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && overlay.classList.contains("open")) {
				close();
			}
		});
	})();
</script>

<style>
	.home {
		overflow: clip;
	}

	/* ---------- Section scaffolding ---------- */
	.section {
		padding: var(--section-y) var(--page-gutter);
	}

	.section-head {
		max-width: var(--wide-width);
		margin: 0 auto var(--spacing-12);
	}

	.section-title {
		font-size: var(--font-size-section);
		font-weight: var(--font-weight-heading);
		letter-spacing: -0.01em;
		max-width: 26ch;
	}

	/* Green family background (design.md 4.3) */
	.section--green {
		background: var(--color-green-1);
	}

	.section--green .section-title {
		color: var(--color-text);
	}

	/* Blue family background (design.md 4.4) */
	.section--blue {
		background: var(--color-blue-1);
	}

	.section--blue .section-title {
		color: var(--color-text);
	}

	/* ---------- Hero (design.md 4.2, homepage-spec.md 3) ---------- */
	.hero {
		position: relative;
		background: var(--color-hero-bg);
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--spacing-6);
		max-width: var(--slim-width);
		margin: 0 auto;
		padding: var(--spacing-24) var(--page-gutter) var(--spacing-20);
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-family: var(--font-brand);
		font-size: var(--text-small-desktop);
		font-weight: 600;
		line-height: var(--leading-label);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.hero-eyebrow::before {
		content: "";
		width: var(--space-6);
		height: 1px;
		background: var(--color-action);
	}

	.hero-eyebrow::after {
		content: "";
		width: var(--space-6);
		height: 1px;
		background: var(--color-action);
	}

	.hero-title {
		margin-top: var(--spacing-4);
		font-size: var(--font-size-hero);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-display);
		letter-spacing: -0.01em;
		text-wrap: balance;
		max-width: 20ch;
	}

	.hero-sub {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 52ch;
	}

	.hero-cta {
		margin-top: var(--spacing-4);
	}

	.hero-cta span {
		transition: transform var(--transition-base);
	}

	.hero-cta:hover span {
		transform: translateX(4px);
	}

	/* ---------- Video (green family) ---------- */
	.system {
		border-top: 1px solid var(--color-green-3);
	}

	.system .section-head {
		margin-bottom: var(--spacing-10);
	}

	.system-video {
		max-width: 980px;
		margin: 0 auto;
	}

	.system-video iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border: 1px solid var(--color-green-3);
		border-radius: var(--radius-lg);
		background: #000;
		transition: border-color var(--transition-base);
	}

	.system-video iframe:hover {
		border-color: var(--color-green-4);
	}

	/* ---------- Reviews (blue family) ---------- */
	.reviews {
		border-top: 1px solid var(--color-blue-3);
	}

	.reviews-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
		align-items: start;
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.review-fig {
		margin: 0;
		padding: var(--space-3);
		border: 1px solid var(--color-blue-3);
		border-radius: var(--radius-md);
		background: var(--color-blue-2);
		cursor: zoom-in;
		transition:
			border-color var(--transition-base),
			transform var(--transition-base);
	}

	.review-fig:hover {
		border-color: var(--color-blue-4);
		transform: translateY(-2px);
	}

	.review-fig:focus-visible {
		outline: var(--focus-ring);
		outline-offset: 3px;
	}

	.review-short {
		width: 100%;
		height: auto;
		border-radius: var(--radius-sm);
		display: block;
	}

	/* ---------- Reviews lightbox ---------- */
	.review-lightbox {
		position: fixed;
		inset: 0;
		z-index: 300;
		display: grid;
		place-items: center;
		padding: 4vmin;
		visibility: hidden;
		opacity: 0;
		transition:
			opacity var(--transition-base),
			visibility var(--transition-base);
	}

	.review-lightbox.open {
		visibility: visible;
		opacity: 1;
	}

	.review-lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: var(--color-overlay);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.review-lightbox-fig {
		position: relative;
		margin: 0;
		max-width: min(92vw, 1000px);
		transform: translateY(10px) scale(0.97);
		transition: transform var(--transition-base);
	}

	.review-lightbox.open .review-lightbox-fig {
		transform: none;
	}

	.review-lightbox-img {
		display: block;
		width: auto;
		max-width: 100%;
		max-height: 84vh;
		margin: 0 auto;
		border-radius: var(--radius-lg);
		background: #fff;
	}

	.review-lightbox-close {
		position: absolute;
		top: -52px;
		right: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border-strong);
		background: var(--color-overlay);
		color: var(--color-text);
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
		transition:
			background var(--transition-base),
			color var(--transition-base);
	}

	.review-lightbox-close:hover {
		background: var(--color-action);
		color: var(--color-on-brand);
	}

	/* ---------- Founders (green family) ---------- */
	.founders {
		border-top: 1px solid var(--color-green-3);
	}

	.founders-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-8);
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.founder {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: var(--spacing-10);
		align-items: center;
		padding: var(--spacing-10);
		border: 1px solid var(--color-green-3);
		border-radius: var(--radius-md);
		background: var(--color-green-2);
		transition: border-color var(--transition-base);
	}

	.founder:hover {
		border-color: var(--color-green-4);
	}

	.founder-mirror {
		display: flex;
		align-items: start;
	}

	.founder-side {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-3);
		min-width: 0;
	}

