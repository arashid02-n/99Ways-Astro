---
import { getEmDashEntry, getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [settings, { entry: home }, { entries: posts, cacheHint }] =
	await Promise.all([
		getSiteSettings(),
		getEmDashEntry("pages", "home"),
		getEmDashCollection("posts", {
			status: "published",
			orderBy: { published_at: "desc" },
			limit: 6,
		}),
	]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

/*
 * The homepage is composed from the "home" page entry in the CMS. Its
 * Portable Text blocks are mapped into a structured model here; the
 * academy post list is fetched live from the posts collection.
 */
type ImageRef = { url: string; width?: number; height?: number; alt: string };
type Cta = { label: string; href: string };
type Pillar = {
	image: ImageRef;
	title: string;
	description: string;
	items: string[];
	cta: Cta | null;
};
type Founder = { image: ImageRef; name: string; role: string; bio: string };
type HomeModel = {
	hero: { title: string; subtitle: string; cta: Cta };
	mascot: ImageRef | null;
	system: { title: string; pillars: Pillar[] };
	founders: { title: string; people: Founder[] };
	reviews: { title: string; images: ImageRef[] };
	academy: { title: string; viewAll: string | null };
};

type Block = Record<string, any>;

function blockText(block: Block): string {
	return (block.children ?? [])
		.filter((c: Block) => c._type === "span" && typeof c.text === "string")
		.map((c: Block) => c.text)
		.join("");
}

function blockHref(block: Block): string | null {
	const link = (block.markDefs ?? []).find(
		(md: Block) => md._type === "link" && typeof md.href === "string",
	);
	return link ? link.href : null;
}

function parseHomePage(blocks: Block[]): HomeModel {
	const model: HomeModel = {
		hero: { title: "", subtitle: "", cta: { label: "Book Intro Call", href: "#" } },
		mascot: null,
		system: { title: "", pillars: [] },
		founders: { title: "", people: [] },
		reviews: { title: "", images: [] },
		academy: { title: "", viewAll: null },
	};

	let phase: "hero" | "system" | "founders" | "reviews" | "academy" | "tail" =
		"hero";
	let pillar: Pillar | null = null;
	let person: Founder | null = null;
	const paragraphs: string[] = [];

	const closePillar = () => {
		if (pillar) {
			model.system.pillars.push(pillar);
			pillar = null;
		}
	};
	const closePerson = () => {
		if (person) {
			model.founders.people.push(person);
			person = null;
		}
	};

	for (const b of blocks) {
		if (b._type === "image") {
			const img: ImageRef = {
				url: b.asset?.url ?? "",
				width: b.width,
				height: b.height,
				alt: b.alt ?? "",
			};
			if (phase === "hero") model.mascot = img;
			else if (phase === "system") {
				closePillar();
				pillar = { image: img, title: "", description: "", items: [], cta: null };
			} else if (phase === "founders") {
				closePerson();
				person = { image: img, name: "", role: "", bio: "" };
			} else if (phase === "reviews") model.reviews.images.push(img);
			continue;
		}
		if (b._type !== "block") continue;

		const style = b.style;
		const rawText = blockText(b).trim();
		const text = rawText.replace(/\s+/g, " ").trim();
		const href = blockHref(b);

		if (style === "h1") {
			model.hero.title = text;
			continue;
		}
		if (style === "h2") {
			if (phase === "hero" && !model.hero.subtitle) {
				model.hero.subtitle = text;
				continue;
			}
			closePillar();
			closePerson();
			if (text === "The system behind predictable growth") {
				phase = "system";
				model.system.title = text;
			} else if (text === "About Founders") {
				phase = "founders";
				model.founders.title = text;
			} else if (text.includes("Review")) {
				phase = "reviews";
				model.reviews.title = text;
			} else if (text.includes("Latest from") || text.includes("Academy")) {
				phase = "academy";
				model.academy.title = text;
			} else {
				phase = "tail";
			}
			continue;
		}
		if (style === "normal" && phase === "hero" && href) {
			model.hero.cta = { label: text || model.hero.cta.label, href };
			continue;
		}
		if (phase === "system" && pillar) {
			if (style === "h3") {
				pillar.title = text;
			} else if (style === "normal") {
				if (href) pillar.cta = { label: text, href };
				else if (!pillar.description) pillar.description = text;
				else if (pillar.items.length < 8) pillar.items.push(text);
			}
			continue;
		}
		if (phase === "founders" && person) {
			if (style === "h3") person.name = text;
			else if (style === "h6" && rawText) person.role = rawText;
			else if (style === "normal" && text) paragraphs.push(text);
			continue;
		}
		if (phase === "academy" && style === "h6") {
			model.academy.viewAll = href && href !== "#" ? href : null;
		}
	}
	closePillar();
	closePerson();

	// Assign bio paragraphs to founders in document order.
	model.founders.people.forEach((p, i) => {
		p.bio = paragraphs[i] ?? "";
	});
	return model;
}

const homeModel = parseHomePage(home?.data?.content ?? []);

// "Book Intro Call" in the source content points at "#": wire it to the
// existing scheduling page so the primary CTA is not a dead link.
function resolveCta(cta: Cta | null): Cta {
	if (!cta) return { label: "Book Intro Call", href: "/pages/book-your-free-consultation" };
	const href = cta.href && cta.href !== "#" ? cta.href : "/pages/book-your-free-consultation";
	return { label: cta.label, href };
}

const heroCta = resolveCta(homeModel.hero.cta);
const system = homeModel.system;
const founders = homeModel.founders;
const reviews = homeModel.reviews;
const academy = homeModel.academy;
const mascot = homeModel.mascot;
const foundCtas = resolveCta(null);
---

<Base title={siteTitle} description={siteTagline}>
	<main class="home">
	<!-- 01 · Hero -->
	<header class="hero">
		<div class="hero-inner">
			<div class="hero-copy">
				<span class="hero-eyebrow"><span class="hero-eyebrow-dot" aria-hidden="true"></span>{siteTagline}</span>
				<h1 class="hero-title">Find and Pull Your Biggest Growth Levers with Experimentation</h1>
				<p class="hero-sub">We run your CRO operation, from research and prioritization to implementation and analysis.</p>
				<a class="hero-cta" href={heroCta.href}>
					{heroCta.label}<span aria-hidden="true">→</span>
				</a>
			</div>
			{
				mascot?.url && (
					<figure class="hero-visual">
						<div class="hero-glow" aria-hidden="true"></div>
						<div class="hero-pulse-ring" aria-hidden="true"></div>
						<div class="hero-stage">
							<img
								src={mascot.url}
								width={mascot.width}
								height={mascot.height}
								alt=""
								class="hero-frog"
								fetchpriority="high"
							/>
						</div>
						<div class="hero-shadow" aria-hidden="true"></div>
					</figure>
				)
			}
		</div>
	</header>

	<!-- 02 · Breakthroughs video (latest WordPress content) -->
	{
		(
			<section class="section system">
				<div class="section-head">
					<h2 class="section-title system-title">How I Find CRO Breakthroughs Again and Again</h2>
				</div>
				<figure class="system-video">
					<iframe
						title="How I Find CRO Breakthroughs Again and Again"
						width="720"
						height="540"
						src="https://www.youtube.com/embed/STouQwJZ4bY?feature=oembed"
						loading="lazy"
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
				</figure>
			</section>
		)
	}

		<!-- 03 · About Founders -->
	<!-- 03 · How Partners Review Us -->
	{
		reviews.images.length > 0 && (
			<section class="section reviews">
				<div class="section-head reviews-head">
					<h2 class="section-title">How Partners Review Us</h2>
				</div>
				<div class="reviews-grid">
					<div class="reviews-col">
						{reviews.images
							.filter((_, i) => [0, 3, 8].includes(i))
							.map((img) => (
								<figure
									class="review-fig"
									tabindex="0"
									role="button"
									aria-label="Enlarge review image"
								>
									<img
										src={img.url}
										width={img.width}
										height={img.height}
										alt={img.alt || "Client review"}
										loading="lazy"
										class="review-short"
									/>
								</figure>
							))}
					</div>
					<div class="reviews-col">
						{reviews.images
							.filter((_, i) => ![0, 3, 8].includes(i))
							.map((img) => (
								<figure
									class="review-fig"
									tabindex="0"
									role="button"
									aria-label="Enlarge review image"
								>
									<img
										src={img.url}
										width={img.width}
										height={img.height}
										alt={img.alt || "Client review"}
										loading="lazy"
										class="review-short"
									/>
								</figure>
							))}
					</div>
				</div>
				<div class="review-lightbox" aria-hidden="true">
					<div class="review-lightbox-backdrop" data-close></div>
					<figure class="review-lightbox-fig">
						<img class="review-lightbox-img" alt="" />
						<button
							type="button"
							class="review-lightbox-close"
							aria-label="Close enlarged view"
						>
							×
						</button>
					</figure>
				</div>
			</section>
		)
	}

	<!-- 04 · About Founders (moved down; eyebrow number dropped as obsolete) -->
	{
		founders.people.length > 0 && (
			<section class="section founders">
				<div class="section-head">
					<h2 class="section-title">About Us</h2>
				</div>
				<div class="founders-grid">
					{founders.people.map((person, idx) => (
						<article class={idx === 1 ? "founder founder-mirror" : "founder"}>
							<div class="founder-side">
								{
									person.image.url && (
										<figure class="founder-figure">
											<img
												src={person.image.url}
												width={person.image.width}
												height={person.image.height}
												alt={person.name}
												loading="lazy"
												class="founder-portrait"
											/>
										</figure>
									)
								}
								<h3 class="founder-name">{person.name}</h3>
								<p class="founder-role">{person.role}</p>
							</div>
							<p class="founder-bio">{person.bio}</p>
						</article>
					))}
				</div>
			</section>
		)
	}

		<!-- 05 · Latest from 99Ways Academy -->
		{
			academy.title && (
				<section class="section academy">
					<div class="section-head">
						<h2 class="section-title academy-title">{academy.title}</h2>
					</div>
					{
						posts.length === 0 ? (
							<p class="home-empty">No posts have been published yet.</p>
						) : (
							<div class="academy-grid">
								{posts.map((post) => {
									const category = post.data.terms?.category?.[0];
									const featured = post.data.featured_image;
									const imageUrl =
										typeof featured === "string"
											? featured
											: featured?.meta?.storageKey
												? `/_emdash/api/media/file/${featured.meta.storageKey}`
												: null;
									const href = `/posts/${post.id}`;
									const published = post.data.publishedAt
										? new Date(post.data.publishedAt)
										: null;
									const dateLabel = published
										? published.toLocaleDateString("en-US", {
												year: "numeric",
												month: "short",
												day: "numeric",
											})
										: null;
									const minutes = getReadingTime(post.data.content);
									return (
										<article class="ac-card">
											{imageUrl && (
												<a
													href={href}
													class="ac-media"
													tabindex="-1"
													aria-hidden="true"
												>
													<img
														src={imageUrl}
														alt=""
														loading="lazy"
														class="ac-img"
													/>
												</a>
											)}
											<div class="ac-body">
												<p class="ac-meta">
													{category && (
														<>
															<a
																class="ac-cat"
																href={`/category/${category.slug}`}
															>
																{category.label}
															</a>
															<span class="ac-dot" aria-hidden="true" />
														</>
													)}
													{dateLabel && <span>{dateLabel}</span>}
													{minutes ? (
														<>
															<span class="ac-dot" aria-hidden="true" />
															<span>{minutes} min read</span>
														</>
													) : null}
												</p>
												<h3 class="ac-title">
													<a href={href} class="ac-title-link">
														{post.data.title ?? "Untitled"}
													</a>
												</h3>
												{post.data.excerpt && (
													<p class="ac-excerpt">{post.data.excerpt}</p>
												)}
												<span class="ac-cta">
													Read article
													<span class="ac-arrow" aria-hidden="true">
														→
													</span>
												</span>
											</div>
										</article>
									);
								})}
							</div>
						)
					}
					{academy.viewAll && (
						<div class="ac-more">
							<a class="ac-more-btn" href={academy.viewAll}>
								View all posts
							</a>
						</div>
					)}
				</section>
			)
		}
	</main>
</Base>

<script>
	// Hero frog interactivity:
	// - ambient: the frog subtly leans toward the cursor anywhere over the hero;
	// - hover: over the frog itself it lifts, tilts toward the pointer and
	//   catches more light, then eases back to rest on leave.
	(function () {
		var hero = document.querySelector(".hero");
		var visual = hero && hero.querySelector(".hero-visual");
		if (!hero || !visual) return;
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var frog = visual.querySelector(".hero-frog");
		if (!frog) return;
		var leanT = { x: 0, y: 0 };
		var leanC = { x: 0, y: 0 };
		var hovT = { tx: 0, ty: 0, rx: 0, ry: 0, lift: 0, b: 1, s: 1 };
		var hovC = { tx: 0, ty: 0, rx: 0, ry: 0, lift: 0, b: 1, s: 1 };
		var raf = 0;
		var heroActive = false;
		function settled(a, b) {
			return Math.abs(a - b) < 0.001;
		}
		function tick() {
			leanC.x += (leanT.x - leanC.x) * 0.08;
			leanC.y += (leanT.y - leanC.y) * 0.08;
			if (settled(leanT.x, leanC.x)) leanC.x = leanT.x;
			if (settled(leanT.y, leanC.y)) leanC.y = leanT.y;
			frog.style.setProperty("--hero-fx", (leanC.x * 16).toFixed(1) + "px");
			frog.style.setProperty("--hero-fy", (leanC.y * 12).toFixed(1) + "px");
			frog.style.setProperty("--hero-rr", (leanC.x * 3).toFixed(2) + "deg");
			var k = 0.12;
			hovC.tx += (hovT.tx - hovC.tx) * k;
			hovC.ty += (hovT.ty - hovC.ty) * k;
			hovC.rx += (hovT.rx - hovC.rx) * k;
			hovC.ry += (hovT.ry - hovC.ry) * k;
			hovC.lift += (hovT.lift - hovC.lift) * k;
			hovC.b += (hovT.b - hovC.b) * k;
			hovC.s += (hovT.s - hovC.s) * k;
			frog.style.setProperty("--hf-tx", hovC.tx.toFixed(1) + "px");
			frog.style.setProperty("--hf-ty", hovC.ty.toFixed(1) + "px");
			frog.style.setProperty("--hf-rx", hovC.rx.toFixed(2) + "deg");
			frog.style.setProperty("--hf-ry", hovC.ry.toFixed(2) + "deg");
			frog.style.setProperty("--hf-lift", hovC.lift.toFixed(3));
			frog.style.setProperty("--hf-b", hovC.b.toFixed(3));
			frog.style.setProperty("--hf-scale", hovC.s.toFixed(3));
			var calm =
				leanC.x === leanT.x &&
				leanC.y === leanT.y &&
				settled(hovT.tx, hovC.tx) &&
				settled(hovT.ty, hovC.ty) &&
				settled(hovT.rx, hovC.rx) &&
				settled(hovT.ry, hovC.ry) &&
				settled(hovT.lift, hovC.lift) &&
				settled(hovT.b, hovC.b) &&
				settled(hovT.s, hovC.s);
			if (!calm) {
				raf = requestAnimationFrame(tick);
			} else {
				raf = 0;
			}
		}
		function kick() {
			if (!raf) raf = requestAnimationFrame(tick);
		}
		hero.addEventListener("pointermove", function (e) {
			var r = hero.getBoundingClientRect();
			leanT.x = (e.clientX - r.left) / r.width - 0.5;
			leanT.y = (e.clientY - r.top) / r.height - 0.5;
			heroActive = true;
			kick();
		});
		hero.addEventListener("pointerleave", function () {
			leanT.x = 0;
			leanT.y = 0;
			heroActive = false;
			kick();
		});
		visual.addEventListener("pointerenter", function () {
			visual.classList.add("hovering");
			hovT.lift = 1;
			hovT.b = 1.06;
			hovT.s = 1.02;
			kick();
		});
		visual.addEventListener("pointermove", function (e) {
			var r = frog.getBoundingClientRect();
			var nx = (e.clientX - (r.left + r.width / 2)) / r.width;
			var ny = (e.clientY - (r.top + r.height / 2)) / r.height;
			nx = Math.max(-0.5, Math.min(0.5, nx));
			ny = Math.max(-0.5, Math.min(0.5, ny));
			hovT.tx = nx * 14;
			hovT.ty = ny * 10;
			hovT.rx = ny * -8;
			hovT.ry = nx * 10;
			kick();
		});
		visual.addEventListener("pointerleave", function () {
			visual.classList.remove("hovering");
			hovT.tx = 0;
			hovT.ty = 0;
			hovT.rx = 0;
			hovT.ry = 0;
			hovT.lift = 0;
			hovT.b = 1;
			hovT.s = 1;
			kick();
		});
	})();
</script>

<script>
	// Reviews lightbox: click (or Enter/Space) a review to enlarge it in a
	// modal overlay; close via the button, backdrop, or Escape.
	(function () {
		var section = document.querySelector(".reviews");
		if (!section) return;
		var overlay = section.querySelector(".review-lightbox");
		if (!overlay) return;
		var img = overlay.querySelector(".review-lightbox-img");
		var closeBtn = overlay.querySelector(".review-lightbox-close");
		var lastFocus = null;
		function open(src, alt) {
			lastFocus = document.activeElement;
			img.src = src;
			img.alt = alt || "Client review enlarged";
			overlay.classList.add("open");
			overlay.setAttribute("aria-hidden", "false");
			document.documentElement.style.overflow = "hidden";
			if (closeBtn) closeBtn.focus();
		}
		function close() {
			overlay.classList.remove("open");
			overlay.setAttribute("aria-hidden", "true");
			document.documentElement.style.overflow = "";
			if (lastFocus && lastFocus.focus) lastFocus.focus();
		}
		function openFromFigure(fig) {
			var source = fig.querySelector("img");
			if (!source) return;
			open(source.currentSrc || source.src, source.alt);
		}
		section.querySelectorAll(".review-fig").forEach(function (fig) {
			fig.addEventListener("click", function () {
				openFromFigure(fig);
			});
			fig.addEventListener("keydown", function (e) {
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					openFromFigure(fig);
				}
			});
		});
		overlay.addEventListener("click", function (e) {
			if (e.target.closest("[data-close]") || e.target.closest(".review-lightbox-close")) {
				close();
			}
		});
		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && overlay.classList.contains("open")) {
				close();
			}
		});
	})();
</script>

<script>
	// Founders portrait parallax: each portrait drifts subtly toward the
	// cursor while its card is hovered, then eases back to rest.
	(function () {
		var grid = document.querySelector(".founders-grid");
		if (!grid) return;
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var states = [];
		var raf = 0;
		function tick() {
			var moving = false;
			states.forEach(function (st) {
				st.cx += (st.tx - st.cx) * 0.12;
				st.cy += (st.ty - st.cy) * 0.12;
				if (Math.abs(st.tx - st.cx) > 0.05 || Math.abs(st.ty - st.cy) > 0.05) {
					moving = true;
				}
				st.portrait.style.setProperty("--fp-x", st.cx.toFixed(1) + "px");
				st.portrait.style.setProperty("--fp-y", st.cy.toFixed(1) + "px");
			});
			raf = moving ? requestAnimationFrame(tick) : 0;
		}
		function kick() {
			if (!raf) raf = requestAnimationFrame(tick);
		}
		grid.querySelectorAll(".founder").forEach(function (card) {
			var portrait = card.querySelector(".founder-portrait");
			if (!portrait) return;
			var st = { portrait: portrait, tx: 0, ty: 0, cx: 0, cy: 0 };
			states.push(st);
			card.addEventListener("pointermove", function (e) {
				var r = portrait.getBoundingClientRect();
				var nx = (e.clientX - (r.left + r.width / 2)) / r.width;
				var ny = (e.clientY - (r.top + r.height / 2)) / r.height;
				st.tx = Math.max(-0.5, Math.min(0.5, nx)) * 14;
				st.ty = Math.max(-0.5, Math.min(0.5, ny)) * 12;
				kick();
			});
