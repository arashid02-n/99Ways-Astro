		.nav {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: var(--spacing-4);
			max-width: var(--wide-width);
			margin: 0 auto;
			padding: var(--spacing-3) var(--page-gutter);
			min-height: var(--nav-height);
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: var(--spacing-3);
			color: var(--color-text);
			text-decoration: none;
			min-width: 0;
		}

		.brand-frog {
			width: 44px;
			height: 44px;
			border-radius: 50%;
			object-fit: cover;
			display: block;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			box-shadow: var(--shadow-sm);
		}

		.brand:hover .brand-frog {
			animation: frog-hop 0.55s ease;
		}

		@keyframes frog-hop {
			0% { transform: translateY(0) rotate(0deg); }
			35% { transform: translateY(-7px) rotate(-6deg); }
			70% { transform: translateY(0) rotate(4deg); }
			100% { transform: translateY(0) rotate(0deg); }
		}

		@media (prefers-reduced-motion: reduce) {
			.brand:hover .brand-frog {
				animation: none;
			}
		}

		.nav-right {
			display: flex;
			align-items: center;
			gap: var(--spacing-5);
			margin-inline-start: auto;
		}

		.nav-toggle {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 40px;
			height: 40px;
			padding: 0 10px;
			background: transparent;
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			cursor: pointer;
		}

		.nav-toggle-bar {
			display: block;
			height: 2px;
			width: 100%;
			background: var(--color-text);
			border-radius: 2px;
			transition: transform var(--transition-fast), opacity var(--transition-fast);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: var(--spacing-2);
			font-size: var(--font-size-sm);
		}

		.nav-drop {
			position: relative;
		}

		.nav-top {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: var(--spacing-2) var(--spacing-3);
			background: transparent;
			border: none;
			border-radius: var(--radius);
			cursor: pointer;
			color: var(--color-muted);
			font-family: var(--font-mono);
			font-size: var(--font-size-kicker);
			font-weight: 600;
			line-height: 1;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			transition: color var(--transition-fast), background var(--transition-fast);
		}

		.nav-top:hover,
		.nav-drop:hover .nav-top,
		.nav-drop:focus-within .nav-top,
		.nav-drop.open .nav-top,
		.nav-top.active-parent {
			color: var(--color-text);
			background: var(--color-surface);
		}

		.nav-top svg {
			transition: transform var(--transition-fast);
		}

		.nav-drop:hover .nav-top svg,
		.nav-drop:focus-within .nav-top svg,
		.nav-drop.open .nav-top svg {
			transform: rotate(180deg);
		}

		.nav-menu {
			position: absolute;
			top: calc(100% + 10px);
			left: 0;
			min-width: 320px;
			padding: var(--spacing-3);
			padding-top: calc(var(--spacing-3) + 3px);
			background: var(--color-bg);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-lg);
			overflow: hidden;
			opacity: 0;
			visibility: hidden;
			transform: translateY(8px);
			transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
			z-index: 200;
		}

		.nav-menu::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(90deg, var(--color-success), var(--color-brand));
		}

		.nav-drop:hover .nav-menu,
		.nav-drop:focus-within .nav-menu,
		.nav-drop.open .nav-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.nav-menu-kicker {
			padding: var(--spacing-2) var(--spacing-3) var(--spacing-1);
			font-family: var(--font-mono);
			font-size: var(--font-size-xs);
			font-weight: 600;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			color: var(--color-muted);
		}

		.nav-menu a {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--spacing-3);
			padding: var(--spacing-3);
			border-radius: var(--radius);
			color: var(--color-text-secondary);
			text-decoration: none;
			font-size: var(--font-size-sm);
			font-weight: 500;
			transition: background var(--transition-fast), color var(--transition-fast);
		}

		.nav-menu a:hover,
		.nav-menu a.active {
			background: var(--color-surface);
			color: var(--color-text);
		}

		.nav-menu a .nav-arrow {
			opacity: 0;
			transform: translateX(-4px);
			transition: opacity var(--transition-fast), transform var(--transition-fast);
			color: var(--color-success);
		}

		.nav-menu a:hover .nav-arrow,
		.nav-menu a.active .nav-arrow {
			opacity: 1;
			transform: translateX(0);
		}

		.nav-contact {
			display: inline-flex;
			align-items: center;
			margin-inline-start: var(--spacing-2);
			padding: 0.625rem 1.375rem;
			border-radius: 999px;
			background: var(--color-text);
			color: var(--color-bg);
			font-family: var(--font-mono);
			font-size: var(--font-size-kicker);
			font-weight: 700;
			line-height: 1;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			text-decoration: none;
			border: 1px solid transparent;
			box-shadow: var(--shadow-sm);
			transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
		}

		.nav-contact:hover {
			background: var(--color-success);
			color: #fff;
			transform: translateY(-1px);
			box-shadow: var(--shadow-lg);
		}

		.nav-contact.active {
			outline: 2px solid var(--color-success);
			outline-offset: 2px;
		}

		.nav-admin {
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		.nav-admin:hover {
			color: var(--color-text);
		}

		@media (max-width: 760px) {
			.nav-toggle {
				display: inline-flex;
			}

			.nav-links {
				display: none;
