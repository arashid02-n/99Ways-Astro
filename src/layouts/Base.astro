		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * The site is dark-only (design.md §2). No light/dark toggle,
				 * no theme switcher, no light-dark() adaptation.
				 */
				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-body);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-heading);
					font-weight: var(--font-weight-heading);
					letter-spacing: -0.01em;
				}

				h1 {
					font-weight: var(--font-weight-display);
				}

				::selection {
					background: var(--color-action);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
		.site-header {
			position: sticky;
			top: 0;
			z-index: 100;
			background: color-mix(in srgb, var(--color-bg) 88%, transparent);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			border-bottom: 1px solid var(--color-border-subtle);
			box-shadow: 0 8px 24px -18px color-mix(in srgb, var(--color-text) 35%, transparent);
