			color: var(--color-text);
		}

		@media (max-width: 760px) {
			.nav-toggle {
				display: inline-flex;
			}

			.nav-links {
				display: none;
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				flex-direction: column;
				align-items: stretch;
				gap: var(--spacing-2);
				padding: var(--spacing-4) var(--page-gutter) var(--spacing-6);
				background: var(--color-bg);
				border-bottom: 1px solid var(--color-border);
				box-shadow: var(--shadow-lg);
			}

			.nav-links.open {
				display: flex;
			}

			.nav-drop {
				width: 100%;
			}

			.nav-top {
				width: 100%;
				justify-content: space-between;
				padding: var(--spacing-3);
			}

			.nav-menu {
				position: static;
				display: none;
				min-width: 0;
				margin-top: var(--spacing-1);
				opacity: 1;
				visibility: visible;
				transform: none;
				box-shadow: none;
				border: none;
				border-left: 2px solid var(--color-border);
				border-radius: 0;
			}

			.nav-drop.open .nav-menu {
				display: block;
			}

			.nav-contact {
				margin-inline-start: 0;
				margin-top: var(--spacing-2);
				justify-content: center;
			}
		}

		/* Header search was removed by design; the dedicated /search page remains. */

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer: one unified composition (design.md 15) */
			.site-footer {
				background: var(--color-bg);
				border-top: 1px solid var(--color-border-subtle);
			}

			.footer-main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-12) var(--page-gutter) var(--spacing-8);
			}

			/* Compact two-region layout: legal left, nav right (spec 8) */
			.footer-grid {
				display: grid;
				grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
				gap: var(--spacing-12);
				align-items: start;
				margin-bottom: var(--spacing-6);
			}

			.footer-nav {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-8);
				min-width: 0;
			}

			.footer-col {
				min-width: 0;
			}

			.footer-heading {
				font-family: var(--font-brand);
				font-size: var(--text-small-desktop);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: var(--tracking-eyebrow);
				color: var(--color-text);
				margin-bottom: var(--spacing-3);
			}

			/* Navigation columns: links styled exactly like the display-only text */
			.footer-links {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.footer-links li {
				margin: 0;
				padding: var(--spacing-1) 0;
				color: var(--color-text-secondary);
				font-size: var(--text-label-desktop);
				line-height: var(--leading-label);
			}

			.footer-links a {
				color: inherit;
				text-decoration: none;
			}

			.footer-links a:hover {
				color: inherit;
			}

			/* Social icons below the nav columns: small, restrained (spec 8.2) */
			.foot-social {
				display: flex;
				justify-content: flex-end;
				padding-bottom: var(--spacing-6);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.foot-logos {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-3);
			}

			.foot-logos a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 28px;
				height: 28px;
				padding: 0;
				border-radius: var(--radius-sm);
				opacity: 0.85;
				transition: opacity var(--transition-fast);
			}

			.foot-logos a:hover {
				opacity: 1;
			}

			.foot-logos img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				display: block;
			}

			/* Legal/company block: compact, single column */
			.footer-legal {
				display: grid;
				gap: var(--spacing-2);
			}

			.foot-lead {
				font-size: var(--text-label-desktop);
				line-height: var(--leading-body);
				color: var(--color-text);
				max-width: 52ch;
			}

			.foot-lead em {
				font-style: italic;
			}

			.foot-lead a {
