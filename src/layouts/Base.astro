		/* Header search was removed by design; the dedicated /search page remains. */

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer */
			.site-footer {
				background: var(--color-bg);
				border-top: 1px solid var(--color-border-subtle);
			}

			/* Footer top band: map, social logos, legal */
			.foot-top {
			/* Fixed warm-white ink scale: the band is a fixed graphite tone in
			   both modes, so the legal text uses fixed palette anchors for
			   guaranteed contrast (body 8.4:1, secondary ~4.5:1). */
			--foot-ink: #f4f3ef;
			--foot-soft: #b5b8b1;
				--foot-line: color-mix(in srgb, var(--color-bg) 16%, transparent);
				--foot-tile: color-mix(in srgb, var(--color-bg) 6%, transparent);
			/* Warm graphite: the two fixed palette anchors (#292B2A / #F4F3EF),
			   slightly lifted from graphite so the band sits lighter than the
			   About Us field in dark mode while staying a true footer in both modes. */
			--foot-band: color-mix(in srgb, #292b2a 86%, #f4f3ef);
			background:
				radial-gradient(
					44rem 22rem at 12% 0%,
					color-mix(in srgb, var(--color-success) 10%, transparent),
					transparent 60%
				),
				var(--foot-band);
				color: var(--foot-ink);
			}

			.foot-grid {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: clamp(3rem, 6vw, 5rem) var(--page-gutter) var(--spacing-8);
				display: grid;
				grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
				gap: clamp(2rem, 4vw, 4rem);
				align-items: center;
			}

			.foot-map {
				border: 1px solid var(--foot-line);
				border-radius: calc(var(--radius-lg) + 6px);
				padding: var(--spacing-3);
				background: var(--foot-tile);
				min-width: 0;
			}

			.foot-map iframe {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 3;
				border: 0;
				border-radius: var(--radius-lg);
				background: var(--foot-tile);
			}

			.foot-social {
				min-width: 0;
			}

			.foot-logos {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-4);
			}

			.foot-logos a {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 96px;
				padding: var(--spacing-4);
				border: 1px solid var(--foot-line);
				border-radius: var(--radius-lg);
				background: var(--foot-tile);
				transition:
					border-color 0.3s ease,
					background 0.3s ease;
			}

			.foot-logos a:hover {
				border-color: color-mix(in srgb, var(--color-success) 45%, var(--foot-line));
				background: color-mix(in srgb, var(--color-bg) 10%, transparent);
			}

			.foot-logos img {
				max-width: 100%;
				max-height: 56px;
				width: auto;
				height: auto;
				object-fit: contain;
				display: block;
			}

			.foot-legal {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-8) var(--page-gutter) clamp(3rem, 6vw, 4.5rem);
				border-top: 1px solid var(--foot-line);
				display: grid;
				gap: var(--spacing-3);
			}

			.foot-lead {
				font-size: var(--font-size-lg);
				line-height: var(--leading-relaxed);
				color: var(--foot-ink);
				max-width: 75ch;
			}

			.foot-lead em {
				font-style: italic;
			}

			.foot-lead a {
				color: light-dark(#a6baff, #3558b8);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
				transition: color 0.3s ease;
			}

			.foot-lead a:hover {
				color: var(--color-success);
			}

			.foot-legal p {
				margin: 0;
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
				color: var(--foot-soft);
				max-width: 75ch;
			}

			.foot-legal p strong {
				color: var(--foot-ink);
				font-weight: 600;
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--section-y) var(--page-gutter) var(--spacing-8);
				background: var(--color-bg);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 1.5fr 1fr 1fr 1fr;
				gap: var(--spacing-8);
				margin-bottom: var(--spacing-12);
			}

			.footer-brand {
				max-width: none;
				padding-right: var(--spacing-8);
			}

			.footer-frog-figure {
				margin: 0;
				max-width: 240px;
			}

			.footer-frog {
				width: 100%;
				height: auto;
				display: block;
				filter: drop-shadow(0 18px 28px rgba(20, 35, 22, 0.28));
			}

			.footer-logo {
				font-size: var(--font-size-lg);
				font-weight: 700;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				margin-top: var(--spacing-4);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				line-height: var(--leading-relaxed);
			}

			.footer-description {
				margin-top: var(--spacing-3);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				line-height: var(--leading-relaxed);
			}

			.footer-col {
				min-width: 0;
			}

			.footer-heading {
				font-family: var(--font-mono);
				font-size: var(--font-size-kicker);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: var(--tracking-eyebrow);
				color: var(--color-text);
				margin-bottom: var(--spacing-4);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				color: var(--color-text-secondary);
				text-decoration: none;
				font-size: var(--font-size-sm);
				transition: color var(--transition-fast);
			}

			.footer-links a:hover {
				color: var(--color-text);
			}

			.footer-bottom {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				column-gap: var(--spacing-4);
				row-gap: var(--spacing-2);
				padding: var(--spacing-6) var(--page-gutter);
				background: color-mix(in srgb, var(--color-brand) 60%, #141513);
			}

			.footer-copyright {
				margin: 0;
				font-size: var(--font-size-sm);
				color: #f4f3ef;
			}

			.footer-sep {
				color: color-mix(in srgb, #f4f3ef 45%, transparent);
			}

			.footer-legal-link {
				font-size: var(--font-size-sm);
				color: #f4f3ef;
				text-decoration: none;
				transition: color 0.3s ease;
			}

			.footer-legal-link:hover {
				color: #fff;
				text-decoration: underline;
				text-underline-offset: 3px;
			}

		@media (max-width: 900px) {
			.footer-grid {
				grid-template-columns: 1fr;
				gap: var(--spacing-6);
