		.brand {
			display: inline-flex;
			align-items: center;
			color: var(--color-text);
			text-decoration: none;
			min-width: 0;
		}

		/* Compact mark on mobile, wordmark on desktop (asset_manifest.md 1) */
		.brand-mark {
			height: auto;
			display: block;
		}

		.brand-mark--compact {
			width: 64px;
		}

		.brand-mark--wordmark {
			display: none;
		}

		@media (min-width: 768px) {
			.brand-mark--compact {
				display: none;
			}

			.brand-mark--wordmark {
				display: block;
				width: 200px;
			}
		}

		.nav-right {
			display: flex;
			align-items: center;
			gap: var(--spacing-5);
			margin-inline-start: auto;
		}

		.nav-toggle {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 40px;
			height: 40px;
			padding: 0 10px;
			background: transparent;
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			cursor: pointer;
		}

		.nav-toggle-bar {
			display: block;
			height: 2px;
			width: 100%;
			background: var(--color-text);
			border-radius: 2px;
			transition: transform var(--transition-fast), opacity var(--transition-fast);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: var(--spacing-2);
			font-size: var(--text-label-desktop);
		}

		.nav-drop {
			position: relative;
		}

		.nav-top {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: var(--spacing-2) var(--spacing-3);
			background: transparent;
			border: none;
			border-radius: var(--radius);
			cursor: pointer;
			color: var(--color-text-muted);
			font-family: var(--font-brand);
			font-size: var(--text-small-desktop);
			font-weight: 600;
			line-height: var(--leading-label);
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			transition: color var(--transition-fast), background var(--transition-fast);
		}

		.nav-top:hover,
		.nav-drop:hover .nav-top,
		.nav-drop:focus-within .nav-top,
		.nav-drop.open .nav-top,
		.nav-top.active-parent {
			color: var(--color-text);
			background: var(--color-surface);
		}

		.nav-top svg {
			transition: transform var(--transition-fast);
		}

		.nav-drop:hover .nav-top svg,
		.nav-drop:focus-within .nav-top svg,
		.nav-drop.open .nav-top svg {
			transform: rotate(180deg);
		}

		.nav-menu {
			position: absolute;
			top: calc(100% + 10px);
			left: 0;
			min-width: 320px;
			padding: var(--spacing-3);
			padding-top: calc(var(--spacing-3) + 3px);
			background: var(--color-bg);
			border: 1px solid var(--color-border);
			border-radius: 8px;
			box-shadow: var(--shadow-lg);
			overflow: hidden;
			opacity: 0;
			visibility: hidden;
			transform: translateY(8px);
			transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
			z-index: 200;
		}

		.nav-drop:hover .nav-menu,
		.nav-drop:focus-within .nav-menu,
		.nav-drop.open .nav-menu {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.nav-menu-kicker {
			padding: var(--spacing-2) var(--spacing-3) var(--spacing-1);
			font-family: var(--font-brand);
			font-size: var(--text-small-mobile);
			font-weight: 600;
			letter-spacing: var(--tracking-eyebrow);
			text-transform: uppercase;
			color: var(--color-text-muted);
		}

		.nav-menu a {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--spacing-3);
			padding: var(--spacing-3);
			border-radius: var(--radius-sm);
			color: var(--color-text-secondary);
			text-decoration: none;
			font-size: var(--text-label-desktop);
			font-weight: 500;
			transition: background var(--transition-fast), color var(--transition-fast);
		}

		.nav-menu a:hover,
		.nav-menu a.active {
			background: var(--color-surface);
			color: var(--color-text);
		}

		.nav-menu a .nav-arrow {
			opacity: 0;
			transform: translateX(-4px);
			transition: opacity var(--transition-fast), transform var(--transition-fast);
			color: var(--color-action);
		}

		.nav-menu a:hover .nav-arrow,
		.nav-menu a.active .nav-arrow {
			opacity: 1;
			transform: translateX(0);
		}

		/* Header CTA follows the primary button system (design.md 5.1): green
			default → defined alternate interaction color on hover */
		.nav-contact {
			display: inline-flex;
			align-items: center;
