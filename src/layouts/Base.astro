			/* Final bottom bar: dark blue (homepage-spec.md 9) */
			.footer-bottom {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				column-gap: var(--spacing-4);
				row-gap: var(--spacing-2);
				padding: var(--spacing-4) var(--page-gutter);
				background: var(--color-blue-2);
