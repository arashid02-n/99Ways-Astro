			.foot-grid {
				grid-template-columns: 1fr;
			}

			.foot-map iframe {
				aspect-ratio: 16 / 10;
			}
		}

		@media (max-width: 640px) {
			.footer-grid {
				grid-template-columns: 1fr;
			}

			.foot-logos {
				grid-template-columns: repeat(2, 1fr);
			}

			.foot-logos a {
				min-height: 88px;
			}

			.footer-brand {
				grid-column: span 1;
			}
		}
	</style>

	<script>
		// Header navigation only: mobile toggle, dropdown toggles,
		// dismiss on outside click / Escape.
		(function () {
			var header = document.querySelector(".site-header");
			if (!header) return;
			var toggle = header.querySelector(".nav-toggle");
			var links = header.querySelector("#site-nav-links");
			function closeDrops() {
				header.querySelectorAll(".nav-drop.open").forEach(function (drop) {
					drop.classList.remove("open");
					var btn = drop.querySelector(".nav-top");
					if (btn) btn.setAttribute("aria-expanded", "false");
				});
			}
			if (toggle && links) {
				toggle.addEventListener("click", function () {
					var open = links.classList.toggle("open");
					toggle.setAttribute("aria-expanded", String(open));
					if (!open) closeDrops();
				});
			}
			header.querySelectorAll(".nav-drop > .nav-top").forEach(function (btn) {
				btn.addEventListener("click", function () {
					var drop = btn.parentElement;
					if (!drop) return;
					var wasOpen = drop.classList.contains("open");
					closeDrops();
					if (!wasOpen) {
						drop.classList.add("open");
						btn.setAttribute("aria-expanded", "true");
					}
				});
			});
			document.addEventListener("click", function (e) {
				if (!header.contains(e.target)) {
					closeDrops();
					if (links) links.classList.remove("open");
					if (toggle) toggle.setAttribute("aria-expanded", "false");
				}
			});
			document.addEventListener("keydown", function (e) {
				if (e.key === "Escape") {
					closeDrops();
					if (links) links.classList.remove("open");
					if (toggle) toggle.setAttribute("aria-expanded", "false");
				}
			});
		})();
	</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

