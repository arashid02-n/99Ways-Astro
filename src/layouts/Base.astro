			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: var(--spacing-4);
			max-width: var(--wide-width);
			margin: 0 auto;
			padding: var(--spacing-3) var(--page-gutter);
			min-height: var(--nav-height);
